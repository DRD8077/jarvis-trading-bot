{
  "name": "jarvis-ai-desktop",
  "version": "10.0.0",
  "description": "JARVIS AI v10.0 — Iron Man Holographic Interface. Full AI assistant with camera emotion detection, code execution, system control, voice AI. No server needed.",
  "main": "main.js",
  "author": "JARVIS AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jarvis-ai/trading-desktop"
  },
  "scripts": {
    "start": "electron .",
    "build": "npm run build-web && electron-builder --win --publish never",
    "build-web": "cd ../telegram-mini-app && npm run build",
    "build-win": "electron-builder --win --publish never",
    "build-mac": "electron-builder --mac --publish never",
    "build-linux": "electron-builder --linux --publish never",
    "build-all": "electron-builder --win --mac --linux --publish never",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "install-build": "npm run build-web && electron-builder --win --mac --linux --publish never"
  },
  "build": {
    "appId": "com.jarvis.ai.ironman",
    "productName": "JARVIS AI",
    "copyright": "Copyright 2026 JARVIS AI",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "tray.js",
      "systemControl.js",
      "presenceEngine.js",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../telegram-mini-app/dist",
        "to": "webapp",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "JARVIS-AI-v${version}-Setup.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "shortcutName": "JARVIS AI",
      "runAfterFinish": true,
      "installerSidebar": null,
      "perMachine": false,
      "allowElevation": true
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "JARVIS needs camera access for face detection and emotion recognition",
        "NSMicrophoneUsageDescription": "JARVIS needs microphone access for voice commands"
      }
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "icon": "assets",
      "category": "Utility",
      "desktop": {
        "Name": "JARVIS AI",
        "Comment": "Iron Man AI Assistant",
        "Keywords": "jarvis;ai;assistant;iron-man"
      }
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  }
}
