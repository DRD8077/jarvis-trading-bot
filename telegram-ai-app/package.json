{
  "name": "telegram-ai-app",
  "version": "1.0.0",
  "description": "AI-powered Telegram Mini App with Hindi support, voice, and gesture recognition",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "bot": "node bot/bot.js",
    "build": "echo 'No build step required'",
    "test": "echo 'Tests not implemented yet'",
    "install:ai": "npm install @google/generative-ai whisper-node",
    "install:gesture": "npm install @tensorflow/tfjs @tensorflow-models/posenet @mediapipe/camera_utils @mediapipe/drawing_utils @mediapipe/pose",
    "install:voice": "npm install microsoft-cognitiveservices-speech-sdk",
    "install:all": "npm install && npm run install:ai && npm run install:gesture && npm run install:voice"
  },
  "keywords": ["telegram", "ai", "mini-app", "hindi", "assistant", "voice", "gesture", "live-ai"],
  "author": "JARVIS AI",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "crypto": "^1.0.1",
    "node-telegram-bot-api": "^0.66.0",
    "openai": "^4.20.1",
    "multer": "^1.4.5-lts.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "axios": "^1.6.2",
    "@google/generative-ai": "^0.21.0",
    "whisper-node": "^1.0.9",
    "microsoft-cognitiveservices-speech-sdk": "^1.34.0",
    "@tensorflow/tfjs": "^4.15.0",
    "@tensorflow-models/posenet": "^2.2.2",
    "@mediapipe/camera_utils": "^0.3.0",
    "@mediapipe/drawing_utils": "^0.3.0",
    "@mediapipe/pose": "^0.5.0",
    "socket.io": "^4.7.4",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}