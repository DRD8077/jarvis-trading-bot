# ═══════════════════════════════════════════════════════
#  🤖 J.A.R.V.I.S. — Environment Variables
#  Copy this file: cp .env.example .env
#  Then fill in your actual keys
# ═══════════════════════════════════════════════════════

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TEST_CHAT_ID=your-chat-id
ADMIN_CHAT_ID=your-chat-id
OWNER_CHAT_ID=your-chat-id

# ── AI Providers (Claude is #1 priority) ──
ANTHROPIC_API_KEY=your-anthropic-key
GROQ_API_KEY=your-groq-key
OPENAI_API_KEY=your-openai-key
GEMINI_API_KEY=your-gemini-key

# ── Crypto ──
COINDCX_API_KEY=your-coindcx-key
OWNER_SOLANA_WALLET=your-solana-wallet-address
OWNER_PHANTOM_USERNAME=@your-phantom-username

# ── General ──
WEBHOOK_URL=http://localhost:8000
WATCHLIST=RELIANCE
